---
import BaseLayout from "../layouts/BaseLayout.astro";
import H1 from "../components/H1.astro";
import { Image, getImage } from "astro:assets";
import { ChevronLeft, ChevronRight } from "@lucide/astro";

import carpentry from "../images/services/carpentry.jpg";
import kitchen from "../images/services/kitchen.jpg";
import bespokeStorage from "../images/gallery/bespoke-storage.jpg";
import understairs from "../images/gallery/understairs.jpg";
import mediaWall from "../images/gallery/media-wall.jpeg";
import summerHouse from "../images/gallery/summer-house.jpg";
import aviary from "../images/gallery/aviary.jpg";
import post from "../images/gallery/post.jpg";

// Multi-photo sets live in their own folder; drop files in and they appear,
// ordered by filename.
const folder = (
  files: Record<string, ImageMetadata>,
): ImageMetadata[] =>
  Object.entries(files)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, image]) => image);

const pergola = folder(
  import.meta.glob<ImageMetadata>(
    "../images/gallery/pergola/*.{jpg,jpeg,png,webp,avif}",
    { eager: true, import: "default" },
  ),
);

const frontDoor = folder(
  import.meta.glob<ImageMetadata>(
    "../images/gallery/front-door/*.{jpg,jpeg,png,webp,avif}",
    { eager: true, import: "default" },
  ),
);

const airingCupboard = folder(
  import.meta.glob<ImageMetadata>(
    "../images/gallery/airing-cupboard/*.{jpg,jpeg,png,webp,avif}",
    { eager: true, import: "default" },
  ),
);

const gallery = [
  {
    src: pergola,
    title: "Green oak pergola",
    description:
      "Bespoke green oak pergola with traditional mortise and tenon joinery, drawbore pegs and curved hanging knees, finished in exterior oil.",
  },
  {
    src: bespokeStorage,
    title: "Bespoke storage",
    description: "Bespoke built in storage in Capel-le-Ferne, Kent.",
  },
  {
    src: frontDoor,
    title: "Front door and fan light",
    description:
      "A Upvc front door and fan light replacement to a new hardwood door frame and beautiful salvaged wooden door and stained glass fan light replacement.",
  },
  {
    src: airingCupboard,
    title: "Airing cupboard",
    description:
      "A built in airing cupboard with sliding louvre doors to make the most of a tight space. Including slatted shelves above the radiator and specific cubbys for all the clients utility needs.",
  },
  {
    src: understairs,
    title: "Understairs storage",
    description: "Custom made understairs storage, built to fit the space.",
  },
  {
    src: mediaWall,
    title: "Media wall",
    description: "Bespoke media wall with built-in storage.",
  },
  {
    src: summerHouse,
    title: "Summer house porch",
    description: "Custom built porch extension to an existing summer house.",
  },
  {
    src: aviary,
    title: "Aviary",
    description: "Handmade timber aviary.",
  },
  {
    src: post,
    title: "Porch post",
    description: "Reconditioned and restored porch post.",
  },
  {
    src: carpentry,
    title: "Custom kitchen",
    description:
      "Custom kitchen surface in London. Curved to fit work well with the customers tight space and design.",
  },
  {
    src: kitchen,
    title: "Kitchen installation",
    description: "Full kitchen installation in Folkestone, Kent.",
  }
];

// Pre-generate the lightbox renditions at build time (no client cost).
const items = (
  await Promise.all(
    gallery.map(async (entry) => {
      const sources = Array.isArray(entry.src) ? entry.src : [entry.src];
      const photos = await Promise.all(
        sources.map(async (src, i) => ({
          alt:
            sources.length > 1
              ? `${entry.title} - photo ${i + 1} of ${sources.length}`
              : entry.title,
          full: (await getImage({ src, width: 1600, format: "webp" })).src,
          thumb: (await getImage({ src, width: 160, format: "webp" })).src,
        })),
      );
      return { ...entry, cover: sources[0], photos };
    }),
  )
).filter((item) => item.photos.length > 0);

// Every photo of every item gets its own #photo-N overlay, so the lightbox
// still works with JS off and the hash is a shareable deep link.
let cursor = 0;
const slides = items.flatMap((item, itemIndex) => {
  const first = cursor;
  cursor += item.photos.length;
  return item.photos.map((photo, photoIndex) => ({
    ...photo,
    index: first + photoIndex,
    first,
    itemIndex,
    photoIndex,
    title: item.title,
    description: item.description,
    photos: item.photos,
  }));
});
const firstSlideOf = (itemIndex: number) =>
  slides.find((slide) => slide.itemIndex === itemIndex)!.index;
---

<BaseLayout
  meta={{
    title: "Work Gallery",
    description:
      "View examples of bespoke carpentry work in Folkestone and Kent. Kitchen installations, custom carpentry projects and more.",
    url: "https://harrypearcecarpentry.co.uk/gallery",
  }}
>
  <div data-gallery-body>
    <section class="py-16 bg-muted/20">
      <div
        class="flex flex-col gap-4 items-center text-center justify-center wrapper"
      >
        <H1 title="Gallery" />
        <p class="text-text text-lig">
          Here are some examples of recent work.<br />For specific examples
          please get in touch.
        </p>
      </div>
    </section>
    <section class="py-16" id="gallery">
      <div class="wrapper">
        <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {
            items.map((item, i) => (
              <a
                href={`#photo-${firstSlideOf(i)}`}
                data-lightbox-trigger={i}
                class="group flex h-full flex-col overflow-hidden rounded-md border border-border/50 bg-background transition-colors duration-300 hover:border-border focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                aria-label={
                  item.photos.length > 1
                    ? `View ${item.title} (${item.photos.length} photos)`
                    : `View ${item.title}`
                }
              >
                <span class="block aspect-square w-full overflow-hidden">
                  <Image
                    src={item.cover}
                    alt={item.title}
                    class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="flex items-baseline justify-between gap-3 border-t border-border/50 px-4 py-3 text-left text-sm text-text transition-colors duration-300 group-hover:text-foreground">
                  {item.title}
                  {item.photos.length > 1 && (
                    <span class="shrink-0 text-xs text-text/70">
                      {item.photos.length} photos
                    </span>
                  )}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  {
    slides.map((slide) => (
      <div
        id={`photo-${slide.index}`}
        class="lightbox"
        role="dialog"
        aria-modal="true"
        aria-label={slide.title}
        data-item={slide.itemIndex}
      >
        <a
          href="#gallery"
          class="lightbox__backdrop"
          aria-label="Close"
          tabindex="-1"
        />
        <a href="#gallery" class="lightbox__close" aria-label="Close">
          &times;
        </a>
        <a
          href={`#photo-${(slide.index - 1 + slides.length) % slides.length}`}
          class="lightbox__nav lightbox__nav--prev"
          aria-label="Previous photo"
        >
          <ChevronLeft size={28} aria-hidden="true" />
        </a>
        <a
          href={`#photo-${(slide.index + 1) % slides.length}`}
          class="lightbox__nav lightbox__nav--next"
          aria-label="Next photo"
        >
          <ChevronRight size={28} aria-hidden="true" />
        </a>
        <div class="lightbox__content">
          <img src={slide.full} alt={slide.alt} class="lightbox__image" />
          {slide.photos.length > 1 && (
            <div class="lightbox__thumbs">
              {slide.photos.map((photo, k) => (
                <a
                  href={`#photo-${slide.first + k}`}
                  class="lightbox__thumb"
                  aria-current={k === slide.photoIndex ? "true" : undefined}
                  aria-label={`View photo ${k + 1} of ${slide.photos.length}`}
                >
                  <img src={photo.thumb} alt="" width="64" height="64" />
                </a>
              ))}
            </div>
          )}
          <p class="lightbox__caption">{slide.description}</p>
        </div>
      </div>
    ))
  }
</BaseLayout>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 3.5rem 1.5rem 1.5rem;
    overflow-y: auto;
  }

  /* Pure-CSS modal: the overlay targeted by the #photo-N hash becomes visible. */
  .lightbox:target {
    display: flex;
  }

  .lightbox__backdrop {
    position: fixed;
    inset: 0;
    background: rgb(0 0 0 / 0.85);
  }

  /* Column that fits the viewport: the image absorbs whatever height the
     thumbs and caption leave, so nothing is pushed off screen. */
  .lightbox__content {
    position: relative;
    display: flex;
    margin: auto;
    max-width: min(92vw, 60rem);
    max-height: 100%;
    min-height: 0;
    flex-direction: column;
    align-items: center;
  }

  .lightbox__image {
    min-height: 0;
    max-height: 100%;
    max-width: 100%;
    width: auto;
    flex: 0 1 auto;
    object-fit: contain;
    border-radius: 0.375rem;
  }

  .lightbox__close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    font-size: 1.875rem;
    line-height: 1;
    color: #fff;
  }

  .lightbox__close:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  .lightbox__nav {
    position: fixed;
    top: 50%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    transform: translateY(-50%);
    border-radius: 9999px;
    background: rgb(0 0 0 / 0.5);
    color: #fff;
    transition: background-color 0.2s;
  }

  .lightbox__nav:hover {
    background: rgb(0 0 0 / 0.75);
  }

  .lightbox__nav:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .lightbox__nav--prev {
    left: 0.5rem;
  }

  .lightbox__nav--next {
    right: 0.5rem;
  }

  .lightbox__caption {
    flex: none;
    margin-top: 0.75rem;
    max-width: 42rem;
    text-align: center;
    font-size: 0.8125rem;
    color: #fff;
  }

  .lightbox__thumbs {
    display: flex;
    flex: none;
    max-width: 100%;
    justify-content: flex-start;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding-bottom: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .lightbox__thumbs::-webkit-scrollbar {
    display: none;
  }

  .lightbox__thumb {
    display: block;
    flex: none;
    width: 3rem;
    height: 3rem;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 0.25rem;
    opacity: 0.55;
    transition:
      opacity 0.2s,
      border-color 0.2s;
  }

  .lightbox__thumb img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .lightbox__thumb:hover,
  .lightbox__thumb:focus-visible {
    opacity: 1;
  }

  .lightbox__thumb[aria-current="true"] {
    opacity: 1;
    border-color: #fff;
  }

  .lightbox__thumb:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .lightbox {
      padding: 3rem 1rem 1rem;
    }

    /* Too narrow to sit beside the image, so they overlay its edges. */
    .lightbox__nav {
      width: 2.5rem;
      height: 2.5rem;
    }

    .lightbox__nav--prev {
      left: 0.25rem;
    }

    .lightbox__nav--next {
      right: 0.25rem;
    }

    .lightbox__thumb {
      width: 2.25rem;
      height: 2.25rem;
    }

    .lightbox__caption {
      margin-top: 0.5rem;
      font-size: 0.75rem;
    }
  }
</style>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }

  /* Freeze the page behind the lightbox. The :has() rule covers the no-JS
     path; the class is set by the script so nav via arrow keys keeps it. */
  html:has(.lightbox:target),
  html.lightbox-open {
    overflow: hidden;
  }
</style>

<script>
  const boxes = Array.from(
    document.querySelectorAll<HTMLElement>(".lightbox"),
  );
  const triggers = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-lightbox-trigger]"),
  );
  const inertTargets = [
    document.querySelector<HTMLElement>("[data-gallery-body]"),
    document.querySelector<HTMLElement>("header"),
    document.querySelector<HTMLElement>("footer"),
  ].filter((el): el is HTMLElement => Boolean(el));

  let openedInPage = false;
  let lastItem = -1;

  const indexFromHash = () => {
    const match = location.hash.match(/^#photo-(\d+)$/);
    if (!match) return -1;
    const i = Number(match[1]);
    return i >= 0 && i < boxes.length ? i : -1;
  };

  const sync = () => {
    const index = indexFromHash();
    const open = index >= 0;

    document.documentElement.classList.toggle("lightbox-open", open);
    inertTargets.forEach((el) => (el.inert = open));

    if (open) {
      boxes[index].querySelector<HTMLElement>(".lightbox__close")?.focus();
      lastItem = Number(boxes[index].dataset.item ?? -1);
    } else {
      if (lastItem >= 0) triggers[lastItem]?.focus();
      lastItem = -1;
      openedInPage = false;
    }
  };

  const goTo = (index: number) => {
    // replace, not push, so Escape/back returns to the pre-lightbox entry.
    location.replace(`#photo-${index}`);
  };

  const close = () => {
    if (openedInPage) {
      history.back();
      return;
    }
    const y = window.scrollY;
    location.replace(location.pathname + location.search);
    window.scrollTo(0, y);
  };

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      openedInPage = true;
    });
  });

  boxes.forEach((box) => {
    box.querySelectorAll<HTMLAnchorElement>('a[href="#gallery"]').forEach(
      (link) => {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          close();
        });
      },
    );

    // Thumbs and the prev/next arrows swap photo without stacking history,
    // so one Back press still leaves the lightbox.
    box.querySelectorAll<HTMLAnchorElement>('a[href^="#photo-"]').forEach(
      (link) => {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          location.replace(link.getAttribute("href")!);
        });
      },
    );
  });

  document.addEventListener("keydown", (event) => {
    const index = indexFromHash();
    if (index < 0 || event.metaKey || event.ctrlKey || event.altKey) return;

    if (event.key === "Escape") {
      event.preventDefault();
      close();
    } else if (event.key === "ArrowRight") {
      event.preventDefault();
      goTo((index + 1) % boxes.length);
    } else if (event.key === "ArrowLeft") {
      event.preventDefault();
      goTo((index - 1 + boxes.length) % boxes.length);
    }
  });

  window.addEventListener("hashchange", sync);
  sync();
</script>
