---
import BaseLayout from "../layouts/BaseLayout.astro";
import H1 from "../components/H1.astro";
import { Image, getImage } from "astro:assets";

import carpentry from "../images/services/carpentry.jpg";
import kitchen from "../images/services/kitchen.jpg";
import bespokeStorage from "../images/gallery/bespoke-storage.jpg";

const gallery = [
  {
    src: bespokeStorage,
    title: "Bespoke storage",
    description: "Bespoke built in storage in Capel-le-Ferne, Kent.",
  },
  {
    src: carpentry,
    title: "Custom kitchen",
    description:
      "Custom kitchen surface in London. Curved to fit work well with the customers tight space and design.",
  },
  {
    src: kitchen,
    title: "Kitchen installation",
    description: "Full kitchen installation in Folkestone, Kent.",
  }
];

// Pre-generate a large rendition per photo for the lightbox (build-time, no client cost).
const items = await Promise.all(
  gallery.map(async (image) => ({
    ...image,
    full: (await getImage({ src: image.src, width: 1600, format: "webp" })).src,
  })),
);
---

<BaseLayout
  meta={{
    title: "Work Gallery",
    description:
      "View examples of bespoke carpentry work in Folkestone and Kent. Kitchen installations, custom carpentry projects and more.",
    url: "https://harrypearcecarpentry.co.uk/gallery",
  }}
>
  <section class="py-16 bg-muted/20">
    <div
      class="flex flex-col gap-4 items-center text-center justify-center wrapper"
    >
      <H1 title="Gallery" />
      <p class="text-text text-lig">
        Here are some examples of recent work.<br />For specific examples please
        get in touch.
      </p>
    </div>
  </section>
  <section class="py-16" id="gallery">
    <div class="wrapper">
      <div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
        {
          items.map((image, i) => (
            <a
              href={`#photo-${i}`}
              class="group relative mb-4 block w-full break-inside-avoid overflow-hidden rounded-md border border-border/50"
              aria-label={`View ${image.title}`}
            >
              <Image
                src={image.src}
                alt={image.title}
                class="h-auto w-full object-cover transition duration-300 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <span class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-4 text-left text-white opacity-100 transition-opacity duration-300 md:opacity-0 md:group-hover:opacity-100">
                {image.title}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    items.map((image, i) => (
      <div id={`photo-${i}`} class="lightbox">
        <a href="#gallery" class="lightbox__backdrop" aria-label="Close" tabindex="-1" />
        <div class="lightbox__content">
          <a href="#gallery" class="lightbox__close" aria-label="Close">
            &times;
          </a>
          <img
            src={image.full}
            alt={image.title}
            class="max-h-[80vh] w-auto rounded-md"
          />
          <p class="mt-3 max-w-2xl text-center text-white">
            {image.description}
          </p>
        </div>
      </div>
    ))
  }
</BaseLayout>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  /* Pure-CSS modal: the overlay targeted by the #photo-N hash becomes visible. */
  .lightbox:target {
    display: flex;
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.8);
  }

  .lightbox__content {
    position: relative;
    display: flex;
    max-width: 92vw;
    flex-direction: column;
    align-items: center;
  }

  .lightbox__close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    font-size: 1.875rem;
    line-height: 1;
    color: #fff;
  }
</style>
