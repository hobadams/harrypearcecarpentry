---
import { Image } from "astro:assets";
import ButtonLink from "../components/ButtonLink.astro";
import H1 from "../components/H1.astro";
import Testimonials from "../components/Testimonials.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import main from "../images/main.jpg";
import portrait from "../images/harry-portrait.jpg";
---

<BaseLayout
  meta={{
    title: "Bespoke Carpenter Capel-le-Ferne",
    description:
      "Bespoke carpenter serving Capel-le-Ferne / Folkestone, Kent. Custom carpentry, kitchen fitting, door hanging, flat-pack assembly & more. Free quotes.",
  }}
>
  <section class="py-16 bg-muted/20">
    <div
      class="flex flex-col gap-4 wrapper items-center text-center justify-center"
    >
      <H1 title="Hi, I'm Harry" />
      <p class="text-lg text-text">
        Bespoke carpentry and high-quality interior installations.<br />Serving
        Capel-le-Ferne, Folkestone and other surrounding areas in Kent.
      </p>
      <ButtonLink href="/services" label="View Services" />
    </div>
  </section>

  <section
    class="flex items-center justify-center py-0 md:py-4 md:py-8 max-w-5xl mx-auto"
  >
    <Image
      src={main}
      alt="Harry Pearce and his van in Capel-le-Ferne"
      class="w-full object-cover"
      decoding="async"
      widths={[640, 1024, 1600]}
      sizes="(max-width: 768px) 100vw, 1024px"
    />
  </section>

  <section class="py-8 md:py-16 bg-muted/20">
    <div class="wrapper flex flex-col gap-4">
      <h2 class="text-2xl font-bold">A bit about me</h2>
      <p class="text-text">
        I'm a skilled carpenter specialising in bespoke woodwork and
        high-quality interior installations. With a background in shipbuilding,
        my skills developed in an environment where accuracy and strength are
        essential.
      </p>
      <p class="text-text">
        I focus on tailored solutions rather than one-size-fits-all fixes,
        working closely with clients to create pieces and spaces that are both
        functional and built to last. From custom carpentry and kitchen
        installations to doors, stud walls, and detailed finishing work such as
        architraves, skirting, and fitted storage, every job is approached with
        care and attention to detail.
      </p>
      <p class="text-text">
        If you're looking for reliable, professional craftsmanship with a
        bespoke finish, I'm here to help bring your ideas to life.
      </p>
    </div>
  </section>

  <section class="py-8 md:py-16">
    <div class="wrapper grid md:grid-cols-[2fr_1fr] gap-8">
      <div class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold">No job too small</h2>
        <p class="text-text">
          I take pride in delivering high-quality workmanship with a friendly,
          reliable approach. No job is too small, and I'll work with you to find
          the right solution for your needs.
        </p>
        <ul class="list-disc list-inside text-text">
          <li>Carpentry</li>
          <li>Flat-Pack Assembly</li>
          <li>Kitchen Installation</li>
          <li>Door Fitting & Hanging</li>
          <li>Stud Wall Construction</li>
          <li>Architrave & Skirting</li>
          <li>Shelving & Wall Storage</li>
          <li>much more...</li>
        </ul>
      </div>
      <div>
        <Image
          src={portrait}
          alt="Harry Pearce and little Dylan"
          class="w-full object-cover max-w-[400px]"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <Testimonials />
</BaseLayout>
