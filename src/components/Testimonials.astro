---
import { Star } from "@lucide/astro";
import { testimonials, googleReviewsUrl } from "../data/testimonials";

const featured = testimonials.filter((t) => t.featured);

// Merges into the business node in BaseLayout via the shared @id.
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": "https://harrypearcecarpentry.co.uk/#business",
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    reviewCount: String(featured.length),
  },
  review: featured.map((t) => ({
    "@type": "Review",
    author: { "@type": "Person", name: t.name },
    reviewRating: { "@type": "Rating", ratingValue: "5", bestRating: "5" },
    reviewBody: t.quote,
  })),
};
---

<section class="py-8 md:py-16 bg-white">
  <div class="wrapper flex flex-col gap-8">
    <h2 class="text-2xl font-bold text-center">What my customers say</h2>

    <ul class="grid gap-6 md:grid-cols-3">
      {
        featured.map((t) => (
          <li class="flex flex-col gap-4 rounded-lg border border-border bg-background p-6 shadow-sm">
            <div class="flex gap-1 text-amber-400" aria-label="Rated 5 out of 5">
              {Array.from({ length: 5 }).map(() => (
                <Star size={18} class="fill-current" aria-hidden="true" />
              ))}
            </div>
            <p class="text-text italic">“{t.quote}”</p>
            <div class="mt-auto">
              <p class="font-bold text-foreground">{t.name}</p>
              <p class="text-sm text-text">via Google</p>
            </div>
          </li>
        ))
      }
    </ul>

    <a
      href={googleReviewsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="self-center font-bold text-primary underline underline-offset-4 hover:no-underline"
    >
      View more reviews on Google
    </a>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(reviewSchema, null, 2)} />
